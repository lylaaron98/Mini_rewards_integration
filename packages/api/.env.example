# Copy to `.env` before running the API: `cp packages/api/.env.example packages/api/.env`
#
# This lives in packages/api rather than the repo root because the Prisma CLI
# looks for `.env` relative to its working directory, and Node's built-in
# `--env-file` flag does the same. One file, found by both, no dotenv dependency.

# Port 5433 matches docker-compose.yml. See the comment there for why not 5432.
DATABASE_URL="postgresql://rewards:rewards@localhost:5433/rewards?schema=public"

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
